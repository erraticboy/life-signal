# ==============================================================================
# LIFE SIGNAL — Environment Configuration Template
# Copy to `.env` (backend) and `frontend/.env` (frontend), then fill real values.
# NEVER commit real `.env` files or Firebase service account JSON keys.
# ==============================================================================

# --- Application ---
APP_NAME=LIFE SIGNAL
APP_ENV=development
APP_BASE_URL=http://localhost:5173
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL + PostGIS ---
# Local Windows/WSL/Docker example:
# postgresql+psycopg2://lifesignal:lifesignal_dev@localhost:5432/lifesignal
# Free-tier Neon / Supabase example (ensure PostGIS extension is enabled):
# postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# --- Firebase Admin SDK (Backend Token Verification) ---
# Provide EITHER a local file path to your downloaded Firebase service account JSON
# OR the single-line JSON string (recommended for cloud free-tier deployment).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated list of verified email addresses granted Administrator role
# on authenticated login (email MUST be verified by Firebase/Google).
ADMIN_BOOTSTRAP_EMAILS=

# --- File Storage (Phase 2+) ---
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=10

# --- Email / SMTP Notifications (Phase 2+) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=LIFE SIGNAL
SMTP_FROM_EMAIL=

# --- AI & Duplicate Detection (Phase 3+) ---
YOLO_MODEL_PATH=./weights/infrastructure_yolo.pt
ENABLE_AI_DEMO_FALLBACK=false
DUPLICATE_WEIGHT_IMAGE=0.35
DUPLICATE_WEIGHT_TEXT=0.35
DUPLICATE_WEIGHT_GEO=0.20
DUPLICATE_WEIGHT_TIME=0.10
DUPLICATE_THRESHOLD=0.72

# --- Frontend Vite Configuration (also place in frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

