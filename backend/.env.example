# Backend Environment Variables (copy to backend/.env)
APP_NAME=LIFE SIGNAL
APP_ENV=development
APP_BASE_URL=http://localhost:5173
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL + PostGIS Connection URL
DATABASE_URL=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated verified emails granted admin privileges upon login
ADMIN_BOOTSTRAP_EMAILS=
# Optional single-admin startup lock (when set, only this verified email may hold admin privileges)
SOLE_ADMIN_EMAIL=

# Local Development Auth (keep false in production; only active if APP_ENV=development)
ENABLE_DEV_AUTH=false
DEV_JWT_SECRET=

# Storage & SMTP (used starting in Phase 2)
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=10
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=LIFE SIGNAL
SMTP_FROM_EMAIL=

# Phase 3 AI & Duplicate Detection
YOLO_MODEL_PATH=./weights/infrastructure_yolo.pt
ENABLE_AI_DEMO_FALLBACK=false

